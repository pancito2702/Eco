# ---- Secrets: NEVER in the repository ----
# Update signing key and copies of real databases
local_data_DO_NOT_DISTRIBUTE/
datos_locales_NO_DISTRIBUIR/
# The server database holds its private identity key, the accounts and the history
*.db
*.db-wal
*.db-shm
*.db-journal
copias/
# Just in case: any loose key or certificate
*.key
*.pem
*.p12
*.pfx
clave*.txt
*signing_key*.txt
.env

# ---- Executables and build output ----
*.exe
*.dll
*.so
*.dylib
*.a
*.lib
*.obj
*.o
bin/
build/
build-*/
out/
# dist/: only the hand-written documents go in (README.txt, install.sh). The rest (executables, signed updates,
# checksums) is made by build.ps1 and signed with the publisher's own key: whoever builds Eco publishes their own.
dist/*
!dist/README.txt
!dist/linux/
dist/linux/*
!dist/linux/install.sh

# ---- What the programs leave behind when used ----
fallos/
eco_fallos/
*.log
__pycache__/

# ---- Editors and OS ----
.vs/
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
